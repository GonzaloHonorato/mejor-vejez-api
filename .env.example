# Copiar a `.env` (NO se versiona). En Dokploy van en la pestaña Environment.
# Compose sólo pasa al contenedor las variables LISTADAS en docker-compose.yml.

# ── Oracle ──────────────────────────────────────────────────────────────────
# Alias de tnsnames.ora dentro del wallet (p. ej. mejorvejez_high).
ORACLE_TNS_ALIAS=
ORACLE_USERNAME=
ORACLE_PASSWORD=
# Wallet en base64 (zip de Oracle o tar.gz). Generarlo con:
#   base64 -i Wallet_xxx.zip | tr -d '\n' | pbcopy
ORACLE_WALLET_BASE64=

# ── Firebase ────────────────────────────────────────────────────────────────
# Project ID de la consola de Firebase. No es secreto.
FIREBASE_PROJECT_ID=

# ── App ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://mejor-vejez-app.adndigital.cl
# validate: Hibernate solo verifica el esquema que crea Flyway.
JPA_DDL_AUTO=validate

# ── Microservicios de Alertas y de Reportes (Fase 9) ────────────────────────
# Clave compartida entre los microservicios: la MISMA en core, alertas y
# reportes. Generar una larga y aleatoria (p. ej. `openssl rand -hex 32`).
# Nunca versionarla.
CLAVE_SERVICIO=
# URLs internas de los otros dos microservicios.
ALERTAS_URL=http://mejor-vejez-alertas:8081
REPORTES_URL=http://mejor-vejez-reportes:8082
# Timeout de LECTURA (segundos) por servicio; la conexión usa 5 s fijos. Si se
# agota, la corrida manual responde 504 (la corrida remota puede seguir en
# curso), no 503. Default: 120 (alertas) y 600 (reportes, SMTP real y varios
# grupos de reporte semanal pueden tardar varios minutos).
# ALERTAS_TIMEOUT_SEG=120
# REPORTES_TIMEOUT_SEG=600

# ── Creación de cuentas y recuperación de contraseña ────────────────────────
# Cuenta de servicio de Firebase en base64 (consola de Firebase → Configuración
# del proyecto → Cuentas de servicio → Generar nueva clave privada). Generarla con:
#   base64 -i mejor-vejez-app-firebase-adminsdk.json | tr -d '\n' | pbcopy
# Es un SECRETO: nunca versionarla. Vacía = la creación de cuentas responde 503.
FIREBASE_CREDENCIALES_BASE64=
# URL pública de la web (correo de cuenta nueva y enlace de recuperación).
APP_URL=https://mejor-vejez-app.adndigital.cl
