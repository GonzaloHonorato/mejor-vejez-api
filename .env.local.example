# Copiar a `.env.local` (NO se versiona) para correr la API en local contra el
# Oracle de docker-compose.local.yml. NUNCA usar estas variables contra la ADB
# de producción ni mezclarlas con `.env` (ese es para el wallet/ADB).
#
#   cp .env.local.example .env.local
#   set -a; source .env.local; set +a
#   ./mvnw spring-boot:run

# ── Oracle local (docker-compose.local.yml) ─────────────────────────────────
# Sobrescribe la URL con wallet de application.properties: se conecta directo
# por host:puerto al Oracle Free local, sin TNS_ADMIN ni wallet.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_USERNAME=mejorvejez
ORACLE_PASSWORD=mejorvejez

# ── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=mejor-vejez-app

# ── App ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200
# Flyway crea el esquema; Hibernate solo lo valida.
JPA_DDL_AUTO=validate
