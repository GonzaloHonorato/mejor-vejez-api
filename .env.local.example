# Copiar a `.env.local` (NO se versiona) para correr la API en local contra el
# Oracle de docker-compose.local.yml. NUNCA usar estas variables contra la ADB
# de producción ni mezclarlas con `.env` (ese es para el wallet/ADB).
#
#   cp .env.local.example .env.local
#   set -a; source .env.local; set +a
#   ./mvnw spring-boot:run

# ── Oracle local (docker-compose.local.yml) ─────────────────────────────────
# Sobrescribe la URL con wallet de application.properties: se conecta directo
# por host:puerto al Oracle Free local, sin TNS_ADMIN ni wallet.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_USERNAME=mejorvejez
ORACLE_PASSWORD=mejorvejez

# ── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=mejor-vejez-app

# ── App ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200
# Flyway crea el esquema; Hibernate solo lo valida.
JPA_DDL_AUTO=validate

# ── Microservicios de Alertas y de Reportes ─────────────────────────────────
# La MISMA clave en core, alertas y reportes (generarla con `openssl rand -hex 32`).
# Sin ella, las rutas internas rechazan todo y las corridas manuales dan 503.
# Se exporta aparte en cada terminal (ver la guía de instalación local); si la
# defines acá vacía, el `source` pisaría la exportada.
# CLAVE_SERVICIO=
ALERTAS_URL=http://localhost:8081
REPORTES_URL=http://localhost:8082
# Timeout de LECTURA (segundos) por servicio; defaults 120 (alertas) y 600
# (reportes). Un corte por este timeout da 504, no 503 (ver README).
# ALERTAS_TIMEOUT_SEG=120
# REPORTES_TIMEOUT_SEG=600

# ── Creación de cuentas y recuperación de contraseña ────────────────────────
# Cuenta de servicio de Firebase en base64. Igual que CLAVE_SERVICIO, se exporta
# aparte en la terminal (ver la guía de instalación local) para no dejarla en
# un archivo. Sin ella, crear cuentas responde 503.
# FIREBASE_CREDENCIALES_BASE64=
APP_URL=http://localhost:4200
